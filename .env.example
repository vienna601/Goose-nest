# Copy to .env and fill in. .env is gitignored; never commit it.

# Supabase -> Project Settings -> API Keys
SUPABASE_URL=https://<your-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...          # server only. Bypasses RLS.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_... # safe in B's frontend bundle

# Goes in the scraper's User-Agent so a site owner can reach us.
SCRAPER_CONTACT_EMAIL=you@example.com

# Agent (A11+)
STEEL_API_KEY=
ANTHROPIC_API_KEY=
