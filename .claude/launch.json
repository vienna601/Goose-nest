{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd backend && ../.venv/bin/uvicorn main:app --port 8000"
      ],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "backend-agent",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd backend && ../.venv/bin/python -m uvicorn main:app --host 127.0.0.1 --port 8010"
      ],
      "port": 8010,
      "autoPort": false
    },
    {
      "name": "frontend-agent",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd frontend && VITE_API_TARGET=http://127.0.0.1:8010 npx vite --port 5180 --strictPort"
      ],
      "port": 5180,
      "autoPort": false
    }
  ]
}